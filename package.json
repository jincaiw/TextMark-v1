{
  "name": "textmark",
  "private": true,
  "version": "0.8.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "build:preview-host": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wdio run wdio.conf.mjs",
    "build:e2e": "cross-env VITE_WDIO=1 tauri build --debug --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"e2e/**/*.mjs\" \"scripts/**/*.mjs\" \"vite.config.ts\" \"vitest.config.ts\" \"wdio.conf.mjs\" \"eslint.config.js\" \"package.json\" \"tsconfig.json\" \"tsconfig.node.json\" \".prettierrc.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"e2e/**/*.mjs\" \"scripts/**/*.mjs\" \"vite.config.ts\" \"vitest.config.ts\" \"wdio.conf.mjs\" \"eslint.config.js\" \"package.json\" \"tsconfig.json\" \"tsconfig.node.json\" \".prettierrc.json\""
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6.11.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.7",
    "@lezer/highlight": "^1.2.3",
    "@sentry/react": "^10.70.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.4.1",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@uiw/react-codemirror": "^4.25.11",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.11.1",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "katex": "^0.18.1",
    "lucide-react": "^1.28.0",
    "markdown-it": "^15.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^11.16.1",
    "morphdom": "^2.7.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "overrides": {
    "@puppeteer/browsers": "3.2.0",
    "nanoid": "3.3.18",
    "serialize-javascript": "7.1.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.1",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@wdio/cli": "9.30.1",
    "@wdio/local-runner": "9.30.1",
    "@wdio/mocha-framework": "9.30.1",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
