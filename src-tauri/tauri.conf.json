{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TextMark",
  "version": "0.8.2",
  "identifier": "app.textmark.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TextMark",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0NjlGRThCNEVDOTk0RTgKUldUb2xNbE9pLzVwSkU2ZUV6L2cxVzdUcFpkb2xQVFdKWTRoTHdwOWVLS2ZvaXhMbmFQQlpwcGEK",
      "endpoints": [
        "https://github.com/jincaiw/TextMark-v1/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": ["textmark"]
      }
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright © 2026 TextMark contributors",
    "createUpdaterArtifacts": true,
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "category": "Productivity",
    "shortDescription": "Fast cross-platform Markdown preview and editor",
    "longDescription": "TextMark is a native-feeling Markdown preview, editing and project navigation app for Windows, Linux and macOS.",
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd",
          "mkdn",
          "mdwn",
          "mdtxt",
          "mdtext",
          "rmd",
          "txt"
        ],
        "name": "Markdown Document",
        "description": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis",
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
